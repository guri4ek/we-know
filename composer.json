{
    "name": "guri4ek/we-know",
    "type": "project",
    "license": "MIT",
    "description": "Instant Answer: a contextual absurdity answer engine",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "doctrine/dbal": "^4.4",
        "doctrine/migrations": "^3.9",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo": "*",
        "php": ">=8.4",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/stopwatch": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*"
    },
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "db:reset": "@php bin/console app:db reset --no-interaction",
        "db:migrate": "@php bin/console app:db migrate --no-interaction",
        "db:seed": "@php bin/console app:db seed --no-interaction",
        "db:fresh": ["@db:reset", "@db:migrate", "@db:seed"]
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    }
}
