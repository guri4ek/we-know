APP_ENV=dev
APP_DEBUG=1
APP_SECRET=
JEV_MODEL=jev-1.13.0
JEV_API_KEY=
JEV_TIMEOUT=0.60
JEV_MAX_DURATION=0.80

# Nonsecret backend defaults; secrets remain in local environment configuration.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/we-know.sqlite"
APP_PUBLIC_ORIGIN=http://localhost:8000
TRUSTED_PROXIES=
ANSWER_RATE_LIMIT=10
ANSWER_RATE_INTERVAL="1 minute"
