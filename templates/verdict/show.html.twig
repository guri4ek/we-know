<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Saved answer — Instant Answer</title>
    <link rel="canonical" href="{{ canonical }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ verdict.questionSnapshot }}">
    <meta property="og:description" content="{{ verdict.answerSnapshot }}">
    <meta property="og:url" content="{{ canonical }}">
</head>
<body>
    <main>
        <h1>Saved answer</h1>
        <p>{{ verdict.questionSnapshot }}</p>
        <p>{{ verdict.answerSnapshot }}</p>
        <a href="/">Instant Answer</a>
    </main>
</body>
</html>
