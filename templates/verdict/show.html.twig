{% extends 'base.html.twig' %}
{% block title %}Saved answer — Instant Answer{% endblock %}
{% block metadata %}
    <link rel="canonical" href="{{ canonical }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ verdict.questionSnapshot }}">
    <meta property="og:description" content="{{ verdict.answerSnapshot }}">
    <meta property="og:url" content="{{ canonical }}">
{% endblock %}
{% block main_class %}saved-page{% endblock %}
{% block body %}
    <h1 class="saved-heading">A question asked. <span>A matter settled.</span></h1>
    {% include 'verdict/_card.html.twig' with { question: verdict.questionSnapshot, answer: verdict.answerSnapshot, share_url: canonical, inline: false } only %}
    <p class="page-note">A saved verdict. The same answer, every time you visit.</p>
{% endblock %}
